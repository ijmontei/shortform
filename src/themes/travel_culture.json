        "success_thresholds": {
            "min_average_percent_viewed": 0.7,
            "min_engaged_view_rate": 0.55,
            "min_like_rate": 0.025
        }
    },
    "scoring_weights": {
        "hook": 0.16,
        "payoff": 0.14,
        "standalone_context": 0.14,
        "theme_signal": 0.14,
        "public_popularity": 0.1,
        "captionability": 0.08,
        "visual_quality": 0.07,
        "pacing": 0.07,
        "transformation": 0.1
    },
    "experiments": {
        "enabled": true,
        "active": []
    },
    "phase": "phase_two",
    "phase_one_active": false
}

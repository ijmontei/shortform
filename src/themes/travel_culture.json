{
    "theme": "travel_culture",
    "profile": "travel",
    "brand": {
        "channel_name": "The Travel Culture Archive",
        "positioning": "Useful and human travel/culture interview moments from people with real experience.",
        "audience": "Travel-curious viewers who want specific places, mistakes, customs, and stories.",
        "viewer_promise": "A concrete local detail, travel mistake, or cultural insight per clip.",
        "voice": "grounded guide",
        "risk_tolerance": "medium"
    },
    "youtube": {
        "channel_handle": "",
        "token_file": ""
    },
    "channels": [
        "https://www.youtube.com/@YesTheory/videos",
        "https://www.youtube.com/@KaraandNate/videos",
        "https://www.youtube.com/@DrewBinsky/videos",
        "https://www.youtube.com/@RickSteves/videos",
        "https://www.youtube.com/@Attach\u00e9/videos",
        "https://www.youtube.com/@TheTravelingClatt/videos",
        "https://www.youtube.com/@GeographyNow/videos",
        "https://www.youtube.com/@Vagabrothers/videos",
        "https://www.youtube.com/@NomadicMatt/videos",
        "https://www.youtube.com/@NasDaily/videos"
    ],
    "research": {
        "priority": "high",
        "community_thesis": "Useful and human travel/culture interview moments from people with real experience.",
        "source_strategy": "Travel/culture creators and interview-adjacent channels with useful place-specific insight."
    },
    "clip_rules": {
        "candidate_durations": [
            18,
            28,
            40,
            55
        ],
        "min_clip_duration": 12,
        "max_clip_duration": 60,
        "default_clip_count": 8,
        "theme_clip_budget": 0,
        "theme_candidates_per_video": 6,
        "min_readiness_score": 0.66,
        "min_selected_score": 0.28,
        "max_topic_similarity": 0.56,
        "candidate_stride_seconds": 4,
        "allow_cold_open": true,
        "prefer_context": true,
        "prefer_fast_payoff": false,
        "prefer_practicality": true,
        "prefer_explanation": false
    },
    "theme_signals": {
        "enabled": [
            "travel_mistake",
            "local_custom",
            "food_discovery",
            "budget_tip",
            "cultural_insight"
        ],
        "required": [],
        "positive_keywords": [
            "local",
            "custom",
            "transport",
            "budget",
            "food",
            "culture",
            "mistake"
        ],
        "negative_keywords": [],
        "archetypes": [
            "travel_mistake",
            "local_custom",
            "food_discovery",
            "budget_tip",
            "cultural_insight"
        ],
        "penalize_missing_theme_signal": true
    },
    "packaging": {
        "intro_modes": [
            "context_card",
            "clip_then_takeaway",
            "editorial_countdown"
        ],
        "default_intro_mode": "context_card",
        "max_intro_seconds": 2.5,
        "caption_style": "place_specific",
        "framing_style": "speaker_context",
        "overlay_style": "map_card"
    },
    "metadata_style": {
        "title_style": "specific_curiosity",
        "title_templates": [
            "The Travel Mistake Behind {topic}",
            "This Local Detail Changes {topic}",
            "Why {topic} Surprises Visitors"
        ],
        "description_style": "source_plus_context",
        "hashtags": [
            "#travel",
            "#culture",
            "#adventure",
            "#shorts"
        ],
        "tags": [
            "travel",
            "culture",
            "local tips",
            "food travel",
            "travel advice"
        ],
        "topic_tags": {
            "local": "#local",
            "custom": "#custom",
            "transport": "#transport",
            "budget": "#budget",
            "food": "#food",
            "culture": "#culture",
            "mistake": "#mistake"
        }
    },
    "risk_controls": {
        "requires_fact_check": false,
        "requires_medical_review": false,
        "requires_financial_review": false,
        "requires_claim_context": true,
        "restricted_topics": [
            "visa claims",
            "border claims",
            "safety claims",
            "current prices"
        ],
        "manual_review_topics": [
            "travel safety",
            "political conflict",
            "visa rules"
        ],
        "minimum_transformation_score": 0.55
    },
    "review_policy": {
        "require_manual_approval_before_public": true,
        "reject_if_reused_risk_high": true,
        "reject_if_first_second_fails": true,
        "reject_if_no_clear_viewer_value": true
    },
    "analytics": {
        "primary_metric": "engaged_view_rate",
        "secondary_metrics": [
            "average_percent_viewed",
            "likes_per_engaged_view",
            "comments_per_engaged_view",
            "subs_gained_per_1000_engaged_views"
        ],
